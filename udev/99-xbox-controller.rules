# udev rules for Xbox controller access via raylib
# raylib reads directly from /dev/input/event* (evdev), unlike SDL2 which
# uses systemd-logind ACLs. Without these rules, non-root users cannot
# open the device nodes and gamepad input will silently fail.
#
# Install:
#   sudo cp 99-xbox-controller.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Verify: replug controller, then check with
#   ls -la /dev/input/event*  (should show your user has rw via ACL)
#   getfacl /dev/input/eventN

# Xbox 360 wired
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="028e", MODE="0666"
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="028f", MODE="0666"

# Xbox 360 wireless
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0719", MODE="0666"

# Xbox One (original)
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02d1", MODE="0666"

# Xbox One S (USB + Bluetooth)
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02ea", MODE="0666"

# Xbox One Elite
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02e3", MODE="0666"

# Xbox Series X|S (USB)
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b12", MODE="0666"

# Xbox Series X|S (Bluetooth 0b13 = share button variant)
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b13", MODE="0666"

# Xbox Adaptive Controller
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b0a", MODE="0666"

# 8BitDo controllers (common Xbox-compatible)
SUBSYSTEM=="input", ATTRS{idVendor}=="2dc8", MODE="0666"

# Generic gamepads (any vendor, gamepad subtypes)
SUBSYSTEM=="input", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0666"